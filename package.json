{
  "name": "ruang-kelas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Administrasi kelas dan pengingat WhatsApp untuk Windows",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
